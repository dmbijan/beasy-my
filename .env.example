# =====================================================
# Beasy.my — Environment Variables Template
# Salin fail ini ke .env.local dan isi nilai sebenar
# =====================================================

# ──────────────────────────────────────────────
# Supabase Configuration
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=<your-supabase-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ⚠️ JANGAN kongsi SERVICE ROLE KEY — ia memberi akses penuh ke database
# Dapatkan dari: Supabase Dashboard > Settings > API

# ──────────────────────────────────────────────
# Google OAuth 2.0 (Drive + Sheets API)
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ──────────────────────────────────────────────
# NextAuth v5 Configuration
# ──────────────────────────────────────────────
# ✅ NextAuth v5 mengutamakan AUTH_SECRET (tapi NEXTAUTH_SECRET masih berfungsi)
# Jana secret: npx auth secret
AUTH_SECRET=<your-auth-secret>
NEXTAUTH_URL=http://localhost:3000

# ──────────────────────────────────────────────
# ToyyibPay Payment Gateway
# ──────────────────────────────────────────────
TOYYIBPAY_SECRET_KEY=<your-toyyibpay-secret>
TOYYIBPAY_CATEGORY_CODE=<your-category-code>

# Production
TOYYIBPAY_BASE_URL=https://toyyibpay.com/index.php/api

# Sandbox (development) — tukar ke atas untuk production:
# TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com/index.php/api

# ──────────────────────────────────────────────
# 🔒 SECURITY: Token Encryption
# ──────────────────────────────────────────────
# ⚠️ WAJIB untuk production! Encrypt Google tokens dalam database
# Jana kunci: openssl rand -hex 32
GOOGLE_TOKENS_ENCRYPTION_KEY=<32-byte-hex-key>

# Contoh janaan kunci di PowerShell:
# [Convert]::ToBase64String((New-Object Byte[] 32)) | Set-Clipboard

# ──────────────────────────────────────────────
# Production Only (.env.production)
# ──────────────────────────────────────────────
# NEXT_PUBLIC_URL=https://beasy.my
# TOYYIBPAY_BASE_URL=https://toyyibpay.com/index.php/api

# ──────────────────────────────────────────────
# Chat AI (optional — LLM upgrade)
# ──────────────────────────────────────────────
# Tanpa key ini, Chat AI guna rule-based (deterministik, percuma).
# Dengan key, Chat AI guna LLM untuk jawapan lebih pintar.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────
# Admin Access
# ──────────────────────────────────────────────
# Emel admin yang dibenarkan akses /admin (panel admin).
# Pisahkan berbilang emel dengan koma.
# ADMIN_EMAILS=you@example.com,partner@example.com
